    "analyze": "node scripts/analyze.js",
    "test": "node scripts/tests/test-unit.js && node scripts/tests/test-form-filler.js && node scripts/tests/test-webcast-resolver.js && node scripts/tests/test-join-flow.js && node scripts/tests/test-gauntlet.js",
