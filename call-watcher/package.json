    "test:registration": "node scripts/tests/test-form-filler.js",
    "test:resolver": "node scripts/tests/test-webcast-resolver.js",
    "test:join": "node scripts/tests/test-join-flow.js",
    "test:gauntlet": "node scripts/tests/test-gauntlet.js",
